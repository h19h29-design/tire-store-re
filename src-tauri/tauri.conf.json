{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tire Store",
  "version": "1.90.0",
  "identifier": "com.tirestore.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tire Store",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/tire-store.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QUEyMDYwMEMxMERCRTkKUldUcDJ4QU1ZQ0NxOTM3NlFNWllFYnFaMStUb0JPamlRdjNWa3pudWpRMkpNcUhXd2k3U1plejYK",
      "endpoints": [
        "https://litire.h19h19.synology.me/tauri-updates/stable/windows/x86_64/{{current_version}}"
      ]
    },
    "sql": {
      "preload": [
        "sqlite:tire-store.db"
      ]
    }
  }
}
